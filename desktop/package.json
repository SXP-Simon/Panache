{
  "name": "handwriting-desktop",
  "version": "1.7.0",
  "private": true,
  "description": "Panache 桌面版（Electron 外壳 + 内置后端）",
  "author": "SXP-Simon",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "bash build.sh",
    "build:app": "bash build.sh --app-only",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "electronVersion": "33.4.11",
    "npmRebuild": false,
    "appId": "io.github.sxp-simon.handwriting",
    "productName": "Panache",
    "afterPack": "./mac-sign.cjs",
    "directories": {
      "output": "build/installer"
    },
    "files": [
      "main.js",
      "app-identity.js",
      "studio-storage.js",
      "app-updates.js",
      "update-transaction.js",
      "preload.js",
      "splash.html",
      "package.json",
      {
        "from": "..",
        "to": ".",
        "filter": [
          "LICENSE"
        ]
      },
      {
        "from": "../frontend/public/fonts/lxgw-wenkai",
        "to": "fonts/lxgw-wenkai",
        "filter": [
          "*.css",
          "*.woff2",
          "OFL.txt"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "build/updater",
        "to": "updater"
      },
      {
        "from": "build/backend/handwriting-backend",
        "to": "backend"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "include": "installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Panache",
      "artifactName": "Panache-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Panache-portable-${version}.exe"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "Panache-${version}-${arch}.${ext}",
      "identity": null
    }
  }
}
