FROM node:24-bookworm-slim AS build-stage
WORKDIR /app
ENV CI=true
RUN npm install --global pnpm@10.13.1
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY frontend/package.json frontend/package.json
COPY desktop/package.json desktop/package.json
COPY e2e/package.json e2e/package.json
COPY scripts/install-hooks.cjs scripts/install-hooks.cjs
RUN pnpm --filter handwrite... install --frozen-lockfile
COPY frontend frontend
RUN pnpm --filter handwrite run build

FROM nginx:stable-alpine AS production-stage
COPY --from=build-stage /app/frontend/dist /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
