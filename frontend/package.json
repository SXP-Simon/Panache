{
  "name": "handwrite",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "vite --host 127.0.0.1 --port 8080",
    "dev": "vite --host 127.0.0.1 --port 8080",
    "build": "pnpm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --project worker/tsconfig.json --noEmit",
    "lint": "oxlint --type-aware --deny-warnings src worker",
    "format": "oxfmt --write src worker vite.config.ts tsconfig.json package.json index.html",
    "format:check": "oxfmt --check src worker vite.config.ts tsconfig.json package.json index.html",
    "test:letter-format": "node tests/chineseLetterFormatter.test.cjs",
    "test:clean-markdown": "node tests/cleanMarkdown.test.cjs",
    "test:latex-unicode": "node tests/latexToUnicode.test.cjs",
    "test:inline-image": "node tests/inlineImageManager.test.cjs",
    "test:generation": "node --test tests/generation.test.cjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.3",
    "katex": "0.18.9",
    "lucide-react": "^1.57.0",
    "motion": "^14.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "valibot": "^1.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "tailwindcss": "^4.0.0",
    "typescript": "7.0.2",
    "vite": "^8.3.4"
  }
}
