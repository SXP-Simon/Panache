{
  "camera": {
    "camera_make": {"type":"string","maxLength":96,"description":"Camera make for export metadata. Used when the paper has no valid EXIF make."},
    "camera_model": {"type":"string","maxLength":96,"description":"Camera model for export metadata when missing from the paper EXIF."},
    "camera_lens": {"type":"string","maxLength":96,"description":"Lens model for export metadata when missing from the paper EXIF. Use ink_softness in the ink group to soften strokes."},
    "camera_iso": {"type":"integer","min":1,"max":65535,"unit":"ISO","description":"ISO for export metadata when missing from the paper EXIF. Ink appearance is controlled by the ink group."}
  },
  "layout": {
    "font_size": {"type":"number","min":1,"max":2048,"unit":"px"},
    "line_spacing": {"type":"number","min":1,"max":10000,"unit":"px"},
    "word_spacing": {"type":"number","min":0,"max":10000,"unit":"px"},
    "left_margin": {"type":"number","min":0,"max":10000,"unit":"px"},
    "right_margin": {"type":"number","min":0,"max":10000,"unit":"px"},
    "top_margin": {"type":"number","min":0,"max":10000,"unit":"px"},
    "bottom_margin": {"type":"number","min":0,"max":10000,"unit":"px"},
    "paper": {"type":"choice","values":["plain","ruled","grid","dots"]},
    "seed": {"type":"integer","min":0,"max":4294967295,"unit":"first section seed"},
    "width": {"type":"integer","min":1,"max":16000,"unit":"px (preset paper)"},
    "height": {"type":"integer","min":1,"max":16000,"unit":"px (preset paper)"},
    "layout_style": {"type":"choice","values":["standard","homework"]},
    "first_line_indent": {"type":"boolean"},
    "monospaced": {"type":"boolean"},
    "english_spacing": {"type":"boolean"}
  },
  "typography": {
    "font": {"type":"font"},
    "latin_font": {"type":"choice","values":["handlee","patrick_hand","indie_flower","kalam","shadows_into_light"],"description":"Optional override for ASCII letters. Omit on a new draft or set to null in tune_handwriting to follow the main font, with fallback for missing glyphs."},
    "latin_font_scale": {"type":"integer","min":50,"max":150,"unit":"%","description":"Size of ASCII letters relative to the main font, also applies to digits when latin_digits is true. Reset to 100 for an unscaled sample."},
    "latin_digits": {"type":"boolean","description":"False keeps 0–9 at the main font and size. True applies the Latin size and any selected Latin font to digits."}
  },
  "ink": {
    "transparent_background": {"type":"boolean","description":"Ink-only PNG preview and ZIP. PDF retains the paper."},
    "ink": {"type":"color"},
    "ink_alpha": {"type":"integer","min":0,"max":255,"description":"Alpha channel of the selected RGBA pen color, before ink opacity."},
    "ink_opacity": {"type":"integer","min":0,"max":100,"unit":"%"},
    "ink_thickness": {"type":"number","min":-2,"max":2,"unit":"px","step":0.1},
    "ink_softness": {"type":"number","min":0,"max":2,"unit":"px","step":0.1}
  },
  "variation": {
    "line_spacing_sigma": {"type":"number","min":0,"max":100,"unit":"px"},
    "font_size_sigma": {"type":"number","min":0,"max":100,"unit":"px"},
    "word_spacing_sigma": {"type":"number","min":0,"max":100,"unit":"px"},
    "perturb_x_sigma": {"type":"number","min":0,"max":100,"unit":"px"},
    "perturb_y_sigma": {"type":"number","min":0,"max":100,"unit":"px"},
    "perturb_theta_sigma": {"type":"number","min":0,"max":3.14,"unit":"rad"},
    "ink_depth_sigma": {"type":"number","min":0,"max":255,"unit":"intensity"}
  },
  "strike": {
    "strikethrough_probability": {"type":"number","min":0,"max":1,"unit":"probability"},
    "strikethrough_width": {"type":"number","min":0,"max":100,"unit":"px"},
    "strikethrough_length_sigma": {"type":"number","min":0,"max":100,"unit":"px"},
    "strikethrough_width_sigma": {"type":"number","min":0,"max":100,"unit":"px"},
    "strikethrough_angle_sigma": {"type":"number","min":0,"max":3.14,"unit":"rad"}
  }
}
