{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 一键启动项目并打开浏览器",
      "dependsOrder": "sequence",
      "dependsOn": [
        "⚡ 全栈开发 - 同时启动前后端",
        "🌐 打开开发页面"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "⚡ 全栈开发 - 同时启动前后端",
      "dependsOrder": "parallel",
      "dependsOn": [
        "frontend",
        "backend"
      ],
      "problemMatcher": []
    },
    {
      "label": "frontend",
      "type": "shell",
      "command": "pnpm",
      "windows": {
        "command": "pnpm.cmd"
      },
      "args": [
        "--filter",
        "handwrite",
        "run",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "NO_COLOR": "1"
        }
      },
      "problemMatcher": {
        "owner": "vite",
        "fileLocation": [
          "relative",
          "${workspaceFolder}/frontend"
        ],
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v\\S+",
          "endsPattern": "Local:\\s+http://127\\.0\\.0\\.1:8080/"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "clear": true
      },
      "detail": "准备 pnpm 依赖并启动 Vite：http://127.0.0.1:8080",
      "dependsOn": "📦 安装前端依赖",
      "isBackground": true,
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "backend",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--extra",
        "dev",
        "--project",
        "..",
        "uvicorn",
        "app:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "5005"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "PYTHONUTF8": "1",
          "PYTHONIOENCODING": "utf-8"
        }
      },
      "problemMatcher": {
        "owner": "python",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^.*\\| .*\\[(?:ERROR|CRITICAL)\\s*\\].*\\| [^|]+ \\| (.+):(\\d+) \\| [^|]+ \\| (.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Will watch for changes|Started reloader process|Started server process",
          "endsPattern": "Application startup complete\\."
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "clear": true
      },
      "detail": "使用 uv 项目环境启动 FastAPI 热重载：http://127.0.0.1:5005",
      "dependsOn": "🐍 安装后端依赖",
      "isBackground": true,
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "🌐 打开开发页面",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--extra",
        "dev",
        "python",
        "-m",
        "webbrowser",
        "-t",
        "http://127.0.0.1:8080"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      },
      "detail": "在系统默认浏览器打开已经启动的前端"
    },
    {
      "label": "📦 安装前端依赖",
      "type": "shell",
      "command": "pnpm",
      "windows": {
        "command": "pnpm.cmd"
      },
      "args": [
        "install",
        "--frozen-lockfile"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "🐍 安装后端依赖",
      "type": "process",
      "command": "uv",
      "args": [
        "sync",
        "--locked",
        "--extra",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "🔧 安装所有依赖",
      "dependsOrder": "parallel",
      "dependsOn": [
        "📦 安装前端依赖",
        "🐍 安装后端依赖"
      ],
      "problemMatcher": []
    },
    {
      "label": "✅ 工程质量检查",
      "type": "shell",
      "command": "pnpm",
      "windows": {
        "command": "pnpm.cmd"
      },
      "args": [
        "run",
        "quality:check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "🧪 单元测试",
      "type": "shell",
      "command": "pnpm",
      "windows": {
        "command": "pnpm.cmd"
      },
      "args": [
        "run",
        "test:unit"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": "test"
    },
    {
      "label": "🏗️ 构建前端项目",
      "type": "shell",
      "command": "pnpm",
      "windows": {
        "command": "pnpm.cmd"
      },
      "args": [
        "--filter",
        "handwrite",
        "run",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": "build"
    },
    {
      "label": "🐳 启动Docker Compose",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "up",
        "--build",
        "-d"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "🛑 停止Docker Compose",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "down"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
