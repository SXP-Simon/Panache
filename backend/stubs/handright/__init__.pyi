from collections.abc import Iterable, Iterator
from collections.abc import Set as AbstractSet

from PIL.Image import Image
from PIL.ImageFont import FreeTypeFont, ImageFont

type Font = FreeTypeFont | ImageFont

class Feature:
    GRID_LAYOUT: int

class LayoutError(Exception): ...

class Template:
    def __init__(
        self,
        background: Image,
        font: Font,
        line_spacing: int | None = ...,
        fill: int | str | tuple[int, ...] | None = ...,
        left_margin: int = ...,
        top_margin: int = ...,
        right_margin: int = ...,
        bottom_margin: int = ...,
        word_spacing: int = ...,
        line_spacing_sigma: float | None = ...,
        font_size_sigma: float | None = ...,
        word_spacing_sigma: float | None = ...,
        start_chars: str = ...,
        end_chars: str = ...,
        perturb_x_sigma: float | None = ...,
        perturb_y_sigma: float | None = ...,
        perturb_theta_sigma: float = ...,
        strikethrough_length_sigma: float | None = ...,
        strikethrough_angle_sigma: float = ...,
        strikethrough_width_sigma: float | None = ...,
        strikethrough_probability: float = ...,
        strikethrough_width: float | None = ...,
        ink_depth_sigma: float | None = ...,
        features: AbstractSet[int] = ...,
    ) -> None: ...
    def get_background(self) -> Image: ...
    def get_font(self) -> Font: ...
    def get_fill(self) -> int | str | tuple[int, ...]: ...
    def get_features(self) -> set[int]: ...
    def get_size(self) -> tuple[int, int]: ...
    def set_background(self, background: Image) -> None: ...
    def set_top_margin(self, margin: int) -> None: ...
    def get_line_spacing(self) -> int: ...
    def get_left_margin(self) -> int: ...
    def get_top_margin(self) -> int: ...
    def get_right_margin(self) -> int: ...
    def get_bottom_margin(self) -> int: ...
    def get_word_spacing(self) -> int: ...
    def get_line_spacing_sigma(self) -> float: ...
    def get_font_size_sigma(self) -> float: ...
    def get_word_spacing_sigma(self) -> float: ...
    def get_perturb_x_sigma(self) -> float: ...
    def get_perturb_y_sigma(self) -> float: ...
    def get_perturb_theta_sigma(self) -> float: ...
    def get_strikethrough_length_sigma(self) -> float: ...
    def get_strikethrough_angle_sigma(self) -> float: ...
    def get_strikethrough_width_sigma(self) -> float: ...
    def get_strikethrough_probability(self) -> float: ...
    def set_strikethrough_probability(self, strikethrough_probability: float = ...) -> None: ...
    def get_strikethrough_width(self) -> float: ...
    def get_ink_depth_sigma(self) -> float: ...
    def get_start_chars(self) -> str: ...
    def get_end_chars(self) -> str: ...

def handwrite(
    text: str, templates: Template | Iterable[Template], seed: int | None = ...
) -> Iterator[Image]: ...
