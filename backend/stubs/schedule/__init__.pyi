from collections.abc import Callable

class Job:
    @property
    def day(self) -> Job: ...
    def at(self, time_str: str) -> Job: ...
    def do(self, job_func: Callable[[], object]) -> Job: ...

def every(interval: int = ...) -> Job: ...
def run_pending() -> None: ...
