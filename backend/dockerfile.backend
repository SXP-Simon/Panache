FROM python:3.12-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:0.13.1 /uv /uvx /bin/

WORKDIR /app
ENV UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1 UV_PYTHON_DOWNLOADS=never
ENV PATH="/app/.venv/bin:$PATH"

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    pandoc \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install only locked runtime dependencies; application files remain a later cache layer.
COPY pyproject.toml uv.lock .python-version /app/
RUN uv sync --locked --no-dev --no-install-project

COPY backend /app
COPY ttf_files /app/font_assets

EXPOSE 5005
CMD ["gunicorn", "app:app", "-b", "0.0.0.0:5005", "-w", "1", "-k", "uvicorn_worker.UvicornWorker", "--timeout", "300", "--access-logfile", "-", "--error-logfile", "-"]
